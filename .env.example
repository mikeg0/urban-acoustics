# Copy to `.env` (gitignored) and adjust for your environment.
# docker compose reads this file automatically for ${VAR} interpolation.

# External Docker network your Traefik reverse proxy is attached to.
TRAEFIK_NETWORK=traefik

# Browser origins allowed to call the API (comma-separated, no `*`).
ALLOWED_ORIGINS=https://urban-acoustics.example.com,http://localhost:5173

# Public URL devices and browsers use for presigned MinIO upload/playback URLs.
S3_PUBLIC_ENDPOINT=https://urban-acoustics-audio.example.com

# Public URL of the MinIO web console.
MINIO_CONSOLE_URL=https://urban-acoustics-minio.example.com

# Extra hostnames the Vite dev server will answer to (comma-separated;
# a leading dot matches subdomains).
VITE_ALLOWED_HOSTS=urban-acoustics.example.com
